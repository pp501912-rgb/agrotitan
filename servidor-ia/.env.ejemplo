# ═══════════════════════════════════════════════════════════════
#  Configuración del servidor de IA local
#  Copiá este archivo a .env y ajustá lo que necesites:
#      cp .env.ejemplo .env
#  El .env NO se versiona (está en .gitignore).
# ═══════════════════════════════════════════════════════════════

# ── Dónde escucha ──────────────────────────────────────────────
# 127.0.0.1 = solo esta máquina (recomendado).
# 0.0.0.0   = accesible desde toda la red local. Leé la sección
#             "Exponer en la red" del README antes de cambiarlo.
BIND_HOST=127.0.0.1
PUERTO_API=11434
PUERTO_WEB=3000

# ── Modelos ────────────────────────────────────────────────────
# El que usan los ejemplos y el que baja `make modelos`.
# Ver la tabla del README para elegir según la RAM disponible.
MODELO=qwen2.5:7b-instruct

# Modelo de embeddings, para búsqueda semántica sobre documentos.
MODELO_EMBEDDINGS=nomic-embed-text

# ── Rendimiento ────────────────────────────────────────────────
# Ventana de contexto en tokens. Más contexto = más RAM.
CONTEXTO=8192
# Modelos distintos cargados en memoria a la vez.
OLLAMA_MAX_LOADED_MODELS=1
# Consultas simultáneas por modelo.
OLLAMA_NUM_PARALLEL=2
# Tiempo que un modelo queda en RAM sin uso (0 = descargar enseguida).
OLLAMA_KEEP_ALIVE=15m

# ── Versiones de las imágenes ──────────────────────────────────
# Fijalas a una versión concreta si querés builds reproducibles.
OLLAMA_VERSION=latest
WEBUI_VERSION=main

# ── Interfaz web ───────────────────────────────────────────────
# true = pide usuario y contraseña (el primero que se registra es
# el admin). Dejalo en true si BIND_HOST no es 127.0.0.1.
WEBUI_AUTH=true
