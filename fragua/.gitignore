# Secretos — nunca al repositorio
.env

# Dependencias
node_modules/

# Lo que genera la app.
#
# Las imágenes NO se versionan: se rehacen desde la ficha con
# `npm run rehacer`, así que son peso muerto en el repositorio. Las
# fichas y los copys SÍ, porque no se reconstruyen con nada.
#
# El PDF del carrusel es lo mismo: lo arma publicarEnLinkedin cada vez
# que publica, desde las mismas placas.
salida/**/*.png
salida/**/*.pdf
salida/respaldos/
*.log

# Basura del sistema
.DS_Store
Thumbs.db

# Los accesos vivos a las redes, que se refrescan solos
.instagram.json
.linkedin.json
